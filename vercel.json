{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "enla.cards"
        }
      ],
      "destination": "https://enlacards.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.enla.cards"
        }
      ],
      "destination": "https://enla.cards/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rewards.enla.mx"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.enlacards.com"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:code([A-Za-z0-9]{3,4})",
      "has": [
        {
          "type": "host",
          "value": "enla.cards"
        }
      ],
      "destination": "/join.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "scan.enlacards.com"
        }
      ],
      "destination": "/scan/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "scan.enlacards.com"
        }
      ],
      "destination": "/scan/:path*"
    }
  ]
}
