{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "enla.cards"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.enla.cards"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rewards.enla.mx"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.enlacards.com"
        }
      ],
      "destination": "https://enlacards.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "scan.enlacards.com"
        }
      ],
      "destination": "/scan/:path*"
    }
  ]
}
